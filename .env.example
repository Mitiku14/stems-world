# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
# Must be a long random string — minimum 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_minimum_64_chars
JWT_EXPIRE=7d

# ─── Email (Nodemailer) ───────────────────────────────────
# Development: use Mailtrap (https://mailtrap.io)
# Production: use SendGrid, Mailgun, AWS SES, etc.
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="E-Learning Platform <no-reply@yourdomain.com>"

# ─── Client ───────────────────────────────────────────────
# Frontend origin — used for CORS and email verification links
CLIENT_URL=http://localhost:3000

# ─── API URL (used by Swagger UI "Try it out") ────────────
# Leave blank in development — defaults to http://localhost:PORT
# On Render: set this to your deployed URL, e.g. https://stems-world-backend.onrender.com
API_URL=

# ─── Google OAuth ─────────────────────────────────────────
# From: https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Admin Seed (used only by: node seed/admin.seed.js) ───
ADMIN_NAME=Super Admin
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe@12345
